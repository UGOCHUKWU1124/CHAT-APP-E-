{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@chat/types": ["libs/shared/types/src/index.ts"],
      "@chat/common": ["libs/shared/common/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
